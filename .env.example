OCR_BIND_ADDRESS=127.0.0.1
OCR_PORT=18100
OCR_INFERENCE_BACKEND=ollama
OCR_INFERENCE_URL=http://host.docker.internal:11434
OCR_INFERENCE_API_TOKEN=
# Optional cloud OCR: only engine=jina uploads pages and incurs API usage.
# Store the real key only in the ignored private deployment .env.
OCR_JINA_API_KEY=
OCR_JINA_BASE_URL=https://api.jina.ai
OCR_JINA_TIMEOUT_SECS=120
OCR_REQUEST_TIMEOUT_SECS=300
OCR_PADDLE_TIMEOUT_SECS=30
OCR_GLM_TIMEOUT_SECS=60
OCR_QWEN_TIMEOUT_SECS=120
OCR_MAX_CONCURRENT_MODEL_REQUESTS=1
OCR_MAX_CONCURRENT_PAGES=4
OCR_MAX_UPLOAD_BYTES=104857600
OCR_PDF_DPI=180
RUST_LOG=ocr_service=info
